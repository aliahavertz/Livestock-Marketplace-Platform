$farmer = $stmt->fetch(PDO::FETCH_ASSOC);

$name = $farmer['farm_name']; 

$stmtUnread = $pdo->prepare("SELECT COUNT(*) FROM notifications WHERE user_id = :uid AND user_type = 'farmer' AND is_read = FALSE");
