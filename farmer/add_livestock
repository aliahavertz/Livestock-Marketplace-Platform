<script>
    function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('mainContent');
            
            sidebar.classList.toggle('closed');
            mainContent.classList.toggle('expanded');
            
            if(window.innerWidth <= 768) {
                sidebar.classList.toggle('open');
            }
        }

        function toggleSubmenu(element) {
            const parentLi = element.parentElement;
            
            if(document.getElementById('sidebar').classList.contains('closed')) {
                toggleSidebar();
                return;
            }
            
            parentLi.classList.toggle('open');
        }

        function toggleProfileDropdown() {
            const dropdown = document.getElementById('dropdownMenu');
            dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
        }

        window.onclick = function(event) {
            if (!event.target.closest('.profile-trigger')) {
                const dropdown = document.getElementById('dropdownMenu');
                if (dropdown) dropdown.style.display = 'none';
            }
        }

    const hiddenInput = document.getElementById('hidden-input');
    const gallery = document.getElementById('imageGallery');
    let selectedFiles = []; 

    hiddenInput.addEventListener('change', function() {
        const files = Array.from(this.files);
        
        files.forEach(file => {
            if (!selectedFiles.some(f => f.name === file.name && f.size === file.size)) {
                selectedFiles.push(file);
                
                const reader = new FileReader();
                reader.onload = function(e) {
                    const div = document.createElement('div');
                    div.className = 'gallery-item';
                    div.innerHTML = `
                        <button type="button" class="remove-img-btn"><i class="fas fa-times"></i></button>
                        <img src="${e.target.result}">
                    `;

                    div.querySelector('.remove-img-btn').onclick = function() {
                        selectedFiles = selectedFiles.filter(f => f !== file);
                        div.remove();
                        updateInputFiles();
                    };

                    gallery.insertBefore(div, gallery.querySelector('.add-image-btn'));
                }
                reader.readAsDataURL(file);
            }
        });
        updateInputFiles();
    });

    function updateInputFiles() {
        const dataTransfer = new DataTransfer();
        selectedFiles.forEach(file => dataTransfer.items.add(file));
        hiddenInput.files = dataTransfer.files;
    }

    document.getElementById("toggleService").addEventListener("change", function() {
        document.getElementById("serviceSection").style.display = this.checked ? "block" : "none";
    });

    const saleTypeSelect = document.getElementById("saleTypeSelect");
    const auctionDetails = document.getElementById("auctionDetails");
    const priceLabel = document.getElementById("priceLabel");
    
    saleTypeSelect.addEventListener("change", function() {
        const isAuction = this.value === "Auction";
        auctionDetails.style.display = isAuction ? "block" : "none";
        priceLabel.innerHTML = isAuction ? 'Starting Bid (RM) <span class="required-vintage">(Required)</span>' : 'Price (RM) <span class="required-vintage">(Required)</span>';
        
        document.querySelectorAll("#auctionDetails input").forEach(input => input.required = isAuction);
    });

    function addDeliveryRow() {
        const container = document.getElementById('delivery-repeater');
        const newRow = document.createElement('div');
        newRow.className = 'delivery-row';
        newRow.innerHTML = `
    <div class="row-inputs">
        <div class="field-group">
            <label>Method Name</label>
            <input type="text" name="delivery_type[]" placeholder="e.g., Express Courier" class="custom-input" required>
        </div>
        <div class="field-group">
            <label>Max Weight (KG)</label>
            <input type="number" name="max_weight[]" placeholder="e.g., 500" class="custom-input" required>
        </div>
        <div class="field-group">
            <label>Fee (RM)</label>
            <input type="number" step="0.01" name="delivery_fee[]" placeholder="0.00" class="custom-input" required>
        </div>
        <button type="button" class="btn-remove-row" onclick="removeRow(this)">
            <i class="fas fa-trash-alt"></i>
        </button>
    </div>
        `;
        container.appendChild(newRow);
    }

    function removeRow(btn) {
        const rows = document.querySelectorAll('.delivery-row');
        if (rows.length > 1) {
            btn.closest('.delivery-row').remove();
        } else {
            alert("At least one delivery option is required (even if it's RM 0 for Pickup).");
        }
    }

    function addHarvestRow() {
        const container = document.getElementById('harvest-repeater');
        const newRow = document.createElement('div');
        newRow.className = 'delivery-row harvest-row';
        newRow.style.animation = "fadeIn 0.3s ease";
        newRow.innerHTML = `
        <div class="row-inputs">
            <div class="field-group">
                <label>Service Type</label>
                <input type="text" name="serviceType[]" placeholder="e.g., Meat Processing" class="custom-input" required>
            </div>
            <div class="field-group">
                <label>Fee (RM)</label>
                <input type="number" step="0.01" name="serviceFee[]" placeholder="0.00" class="custom-input" required>
            </div>
            <button type="button" class="btn-remove-row" onclick="removeHarvestRow(this)">
                <i class="fas fa-trash-alt"></i>
            </button>
        </div>
        `;
        container.appendChild(newRow);
    }

    function removeHarvestRow(btn) {
        const rows = document.querySelectorAll('.harvest-row');
        if (rows.length > 1) {
            btn.closest('.harvest-row').remove();
        } else {
            const row = btn.closest('.harvest-row');
            row.querySelectorAll('input').forEach(input => input.value = '');
        }
    }
</script>


</body>
</html>
