.container {
    width: 100%;
    max-width: 1200px;
    height: 550px;
    margin: 40px auto;
    position: relative;
    background: #000;
    overflow: hidden;
    box-shadow: 0 40px 80px rgba(0,0,0,0.15);
}

.container .slide .item {
    width: 200px;
    height: 300px;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    border-radius: 5px;
    background-position: center;
    background-size: cover;
    transition: 0.5s;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
}

.slide .item:nth-child(1),
.slide .item:nth-child(2) {
    top: 0; left: 0;
    width: 100%; height: 100%;
    transform: translateY(0);
    border-radius: 0;
}

.slide .item:nth-child(3) { left: 55%; }
.slide .item:nth-child(4) { left: calc(55% + 220px); }
.slide .item:nth-child(5) { left: calc(55% + 440px); }
.slide .item:nth-child(n+6) { left: calc(55% + 660px); opacity: 0; }

.item .content {
    position: absolute;
    top: 50%;
    left: 80px;
    transform: translateY(-50%);
    color: #fff;
    width: 400px;
    display: none;
    z-index: 10;
}

.slide .item:nth-child(2) .content { display: block; }

.content .name {
    font-family: 'Playfair Display', serif;
    font-size: 60px;
    font-weight: 400;
    opacity: 0;
    animation: animateContent 1s ease-in-out 1 forwards;
}

.content .des {
    margin: 10px 0 25px;
    font-family: 'Montserrat', sans-serif;
    font-weight: 300;
    opacity: 0;
    animation: animateContent 1s ease-in-out 0.3s 1 forwards;
}

.content button {
    padding: 15px 35px;
    border: none;
    background: var(--accent-gold);
    color: white;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 11px;
    cursor: pointer;
    opacity: 0;
    animation: animateContent 1s ease-in-out 0.6s 1 forwards;
}

@keyframes animateContent {
    from { opacity: 0; transform: translateY(50px); filter: blur(33px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
}

.button {
    position: absolute;
    bottom: 40px;
    width: 100%;
    display: flex;
    justify-content: center;
    gap: 15px;
}

.button button {
    width: 50px;
    height: 50px;
    border: 1px solid rgba(255,255,255,0.4);
    background: rgba(0,0,0,0.3);
    color: white;
    font-size: 24px;
    cursor: pointer;
    backdrop-filter: blur(5px);
    transition: 0.3s;
}

.button button:hover { background: var(--accent-gold); border-color: var(--accent-gold); }
